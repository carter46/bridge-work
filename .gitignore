# Server secrets
config/config.php
storage/app.key

# Uploaded CVs, backups and admin uploads (server-only data)
storage/cvs/*
!storage/cvs/.gitkeep
storage/backups/*
!storage/backups/.gitkeep
uploads/*
!uploads/.htaccess

# Public data copies written by the server on every admin save
assets/data/live-*.json
assets/data/*.tmp
*.log
